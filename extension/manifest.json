{
  "manifest_version": 3,
  "name": "Luga Assist - Gemini Web Bridge",
  "version": "1.0.0",
  "description": "Cầu nối trực tiếp giữa Gemini Web Session và Luga Assist Local Agent cho người khiếm thị.",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "windows",
    "alarms"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Luga Assist Bridge"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
